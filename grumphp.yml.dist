imports:
  - { resource: ./dist/library-conventions.yml }

parameters:
  tasks.phpcs.ignore_patterns:
    - vendor/
    - tests/fixtures/
  code-review.ignore:
    - vendor/
    - tests/fixtures/
  tasks.phpcs.ignore_patterns: '%code-review.ignore%'
  tasks.phpstan.ignore_patterns: '%code-review.ignore%'
  tasks.phpcs.standard: ./resources/library-phpcs-ruleset.xml

grumphp:
  git_hook_variables:
    EXEC_GRUMPHP_COMMAND: 'docker-compose exec -T web'
